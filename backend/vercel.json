{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{tests/**,storage/**,**/__pycache__/**,Dockerfile,*.md}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
