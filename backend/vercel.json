{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{tests/**,storage/**,**/__pycache__/**,Dockerfile,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/v1/maintenance/cleanup",
      "schedule": "17 3 * * *"
    }
  ]
}
