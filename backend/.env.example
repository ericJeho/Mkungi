# Leave the two SUPABASE values empty to keep jobs and files on local disk.
MKUNGI_SUPABASE_URL=https://wluzawxnsblsgllpkvrj.supabase.co
MKUNGI_SUPABASE_SECRET_KEY=sb_secret_...
MKUNGI_SUPABASE_INPUT_BUCKET=uploads
MKUNGI_SUPABASE_OUTPUT_BUCKET=outputs

MKUNGI_OCR_ENGINE=rapidocr
MKUNGI_MAX_UPLOAD_MB=25
MKUNGI_MAX_PAGES=20
MKUNGI_CORS_ORIGINS=["http://localhost:3000"]
# Allow the web app's Vercel preview deployments, e.g.:
# MKUNGI_CORS_ORIGIN_REGEX=https://mkungi-web(-[a-z0-9-]+)?\.vercel\.app
MKUNGI_STORAGE_DIR=./storage

# Abuse limit per visitor (salted IP hash); 0 disables.
MKUNGI_MAX_CONVERSIONS_PER_HOUR=30
MKUNGI_IP_HASH_SALT=change-me
# Retention: the daily clean-up deletes jobs and files older than this.
MKUNGI_RETENTION_HOURS=24
# Vercel Cron sends this as "Authorization: Bearer ..."; without it the clean-up endpoint is disabled.
CRON_SECRET=

# Sign-in: empty = required whenever the SUPABASE values above are set.
# MKUNGI_REQUIRE_AUTH=false
